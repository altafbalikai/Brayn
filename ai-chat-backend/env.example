# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:4200

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ai-chat
MONGO_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
DISABLE_MONGO_TRANSACTIONS=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Refresh Token Cookie Configuration
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SAMESITE=Strict
REFRESH_COOKIE_MAX_AGE=604800000
REFRESH_COOKIE_PATH=/
# REFRESH_COOKIE_DOMAIN=example.com
RETURN_REFRESH_IN_BODY=false

# Password Configuration
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TOKEN_EXPIRES=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=15
AUTH_RATE_LIMIT_MAX=5

# Request Body Size Limits
JSON_BODY_LIMIT=10mb
URL_ENCODED_LIMIT=10mb

# OpenRouter/Gemini API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key

# Email Configuration (SendGrid - preferred)
SENDGRID_API_KEY=your-sendgrid-api-key

# Email Configuration (SMTP - alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Email Settings
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=AI Chat App
MAIL_MAX_RETRIES=3
MAIL_RETRY_MIN_MS=500
SUPPORT_URL=https://support.example.com

# Password Reset Configuration
PASSWORD_RESET_PATH=/reset-password

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=logs

# MongoDB Retry Configuration
MONGO_MAX_RETRIES=5
MONGO_RETRY_DELAY_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT=5000
MONGO_SOCKET_TIMEOUT=45000

# API Documentation
API_BASE_URL=http://localhost:4000
ENABLE_SWAGGER=false

